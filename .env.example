# Copy to .env.local and fill in from your Supabase project
# (Dashboard → Project Settings → Data API / API Keys)
#
# Both are optional. Without them the app still runs, storing everything
# locally in IndexedDB — you just lose cloud backup and multi-device sync.
#
# The anon key is designed to be public and ships in the client bundle;
# row-level security is what protects the data. Never put the service_role
# key here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
